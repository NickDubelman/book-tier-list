---
import TierRow from "../components/TierRow.astro";
import { getTierRows } from "../lib/books";
import "../styles/global.css";

const tierRows = getTierRows();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="A mobile-friendly book tier list scored from 5 to 0.5"
    />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Bitter:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>Nick's Book Log</title>
  </head>

  <body>
    <main class="page-shell">
      <header class="hero">
        <h1>🤓 Nick's Book Log</h1>
        <p class="hero-subtitle">
          Started keeping track in 2025. I read all of these as audiobooks.
        </p>
      </header>

      <section class="tier-list" aria-label="Book tiers from highest to lowest">
        {
          tierRows.map((row) => (
            <TierRow
              rowKey={row.key}
              label={row.label}
              caption={row.caption}
              color={row.color}
              books={row.books}
            />
          ))
        }
      </section>
    </main>

    <div id="book-modal-overlay" class="modal-overlay" aria-hidden="true" style="display:none">
      <div
        id="book-modal"
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-book-title"
      >
        <button class="modal-close" aria-label="Close">✕</button>
        <div class="modal-body">
          <img id="modal-cover" class="modal-cover" src="" alt="" />
          <div class="modal-info">
            <p id="modal-book-title" class="modal-book-title"></p>
            <p id="modal-book-author" class="modal-book-author"></p>
            <p id="modal-book-emojis" class="modal-book-emojis"></p>
            <p id="modal-book-notes" class="modal-book-notes"></p>
            <a
              id="modal-book-goodreads"
              class="modal-book-goodreads"
              href=""
              target="_blank"
              rel="noopener noreferrer"
            >View on Goodreads ↗</a>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { setupModalController } from "../components/ModalController.ts";

      setupModalController();
    </script>
  </body>
</html>

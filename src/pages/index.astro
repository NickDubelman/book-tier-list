---
import TierRow from "../components/TierRow.astro";
import { getTierRows } from "../lib/books";
import "../styles/global.css";

const tierRows = getTierRows();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="A mobile-friendly book tier list scored from 5 to 0.5"
    />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Bitter:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>Nick's Book Log</title>
    <script is:inline>
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.style.colorScheme = saved;
    </script>
  </head>

  <body>
    <main class="page-shell">
      <header class="page-header">
        <div class="page-header-top">
          <h1>🤓 Nick's Book Log</h1>
          <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle dark mode"
          >
            <span
              class="theme-toggle-icon theme-toggle-icon--light"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="4"></circle><path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
              </svg>
            </span>
            <span
              class="theme-toggle-icon theme-toggle-icon--dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </span>
          </button>
        </div>

        <p class="page-header-subtitle">
          Started keeping track in 2025. I read all of these as audiobooks.
        </p>
      </header>

      <section class="tier-list" aria-label="Book tiers from highest to lowest">
        {
          tierRows.map((row) => (
            <TierRow
              rowKey={row.key}
              label={row.label}
              caption={row.caption}
              color={row.color}
              books={row.books}
            />
          ))
        }
      </section>
    </main>

    <dialog id="book-modal" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box p-0 overflow-hidden max-w-[420px]">
        <button class="modal-close" aria-label="Close">✕</button>
        <div class="modal-body">
          <img id="modal-cover" class="modal-cover" src="" alt="" />
          <div class="modal-info">
            <p id="modal-book-title" class="modal-book-title"></p>
            <p id="modal-book-author" class="modal-book-author"></p>
            <p id="modal-book-emojis" class="modal-book-emojis"></p>
            <p id="modal-book-notes" class="modal-book-notes"></p>
            <a
              id="modal-book-goodreads"
              class="modal-book-goodreads"
              href=""
              target="_blank"
              rel="noopener noreferrer">View on Goodreads ↗</a
            >
          </div>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <script>
      import { setupModalController } from "../components/ModalController.ts";

      setupModalController();
    </script>

    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      function getScheme() {
        return (
          document.documentElement.style.colorScheme ||
          (matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light")
        );
      }
      function applyScheme(scheme) {
        document.documentElement.style.colorScheme = scheme;
        localStorage.setItem("theme", scheme);
        btn.setAttribute("aria-pressed", scheme === "dark");
      }
      btn.addEventListener("click", () => {
        applyScheme(getScheme() === "dark" ? "light" : "dark");
      });
      btn.setAttribute("aria-pressed", getScheme() === "dark");
    </script>
  </body>
</html>

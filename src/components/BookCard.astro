---
import type { Book } from "../lib/books";

interface Props {
  book: Book;
  defaultEmojis?: string;
}

const { book, defaultEmojis } = Astro.props;
---

<article class="book-card" data-book-card>
  <button
    type="button"
    class="book-trigger"
    aria-haspopup="dialog"
    aria-controls="book-modal"
    aria-label={`Show details for ${book.title} by ${book.author}`}
    data-title={book.title}
    data-author={book.author}
    data-image={book.image}
    data-notes={book.notes ?? ""}
    data-emojis={book.emojis ?? defaultEmojis ?? ""}
    data-goodreads-url={book.goodreadsUrl ?? ""}
  >
    <img
      src={book.image}
      alt={`Cover for ${book.title}`}
      class="book-cover"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
  </button>
</article>
